---
import { appLink, playLink, type Placement } from "@/lib/site";
interface Props { campaign: string; content: string; placement?: Placement; store?: "apple" | "google" }
const { campaign, content, placement = "inline", store = "apple" } = Astro.props;
---
{store === "google" ? (
  <a class="store-badge store-badge-play" href={playLink(campaign, content, placement)} data-cta={placement} data-store="google">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="#00a0ff" d="M3.61 1.81 13.79 12 3.61 22.19a1.5 1.5 0 0 1-.61-1.24V3.05c0-.52.24-.97.61-1.24z"/><path fill="#ffd500" d="m17.1 15.31-3.31-3.31 3.31-3.31 3.99 2.27c1.13.64 1.13 1.44 0 2.08l-3.99 2.27z"/><path fill="#ff3a44" d="M17.1 15.31 13.79 12 3.61 22.19c.37.39.98.44 1.67.05l11.82-6.93z"/><path fill="#00f076" d="M17.1 8.69 5.28 1.76c-.69-.39-1.3-.34-1.67.05L13.79 12l3.31-3.31z"/></svg>
    <span><small>GET IT ON</small>Google Play</span>
  </a>
) : (
  <a class="store-badge" href={appLink(campaign, content, placement)} data-cta={placement} data-store="apple">
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor"><path d="M16.37 12.6c-.02-2.2 1.8-3.26 1.88-3.31-1.03-1.5-2.62-1.7-3.19-1.73-1.36-.14-2.65.8-3.34.8-.69 0-1.75-.78-2.88-.76-1.48.02-2.85.86-3.61 2.19-1.54 2.67-.39 6.63 1.11 8.8.73 1.06 1.6 2.25 2.75 2.21 1.1-.04 1.52-.71 2.85-.71 1.33 0 1.71.71 2.88.69 1.19-.02 1.94-1.08 2.66-2.15.84-1.23 1.19-2.42 1.21-2.48-.03-.01-2.32-.89-2.32-3.55zM14.17 6.13c.61-.74 1.02-1.76.91-2.78-.88.04-1.94.59-2.57 1.32-.56.65-1.06 1.69-.93 2.69.98.08 1.98-.5 2.59-1.23z"/></svg>
    <span><small>Download on the</small>App Store</span>
  </a>
)}
