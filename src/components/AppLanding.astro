---
// Platform landing page (/android, /iphone): what the app does, what's free, how to install and cancel on that platform.
import { Picture } from "astro:assets";
import Base from "@/layouts/Base.astro";
import Icon from "./Icon.astro";
import PostCard from "./PostCard.astro";
import { APP_STORE, PLAY_STORE, SITE, appLink, playLink } from "@/lib/site";
import { allPosts, heroFor, inline, plain, CATEGORY_LABEL } from "@/lib/content";
import shotCatch from "@/assets/screens/catch-log.png";
import shotBoard from "@/assets/screens/leaderboard.png";
import shotCond from "@/assets/screens/conditions.png";

interface Props { platform: "android" | "iphone" }
const { platform } = Astro.props;
const A = platform === "android";
const name = A ? "Android" : "iPhone";
const store = A ? "Google Play" : "the App Store";
const path = `/${platform}`;
const link = (p: Parameters<typeof appLink>[2]) => (A ? playLink("platform", platform, p) : appLink("platform", platform, p));
const other = A ? { href: "/iphone", label: "PB Fishing for iPhone" } : { href: "/android", label: "PB Fishing for Android" };
const hero = heroFor("pages", platform);
const appPosts = (await allPosts()).filter((p) => p.data.category === "apps").slice(0, 6);

const features = [
  { icon: "camera", t: "Photo-backed catch log", d: "Snap a side-profile photo; the app helps identify the species and estimate length, then saves length, weight, water and a conditions snapshot (weather and pressure) with the catch." },
  { icon: "wifi-off", t: "Logs without signal", d: "Catches you log on the water with no service are stored on the phone and uploaded when you're back online." },
  { icon: "trophy", t: "Personal bests, automatically", d: "Your best fish of every species is tracked for you, with the photo behind it." },
  { icon: "bar-chart-3", t: "State and national leaderboards", d: "Photo-backed catches ranked by species, in your state and nationwide. Seasons reset every six months. An entry shows your name, state, length and weight, not your lake." },
  { icon: "map", t: "20,000+ US waters", d: "Search lakes and rivers, see species and seasonal activity, live conditions and a bite forecast, and plan trips." },
  { icon: "file-badge", t: "License links for every state", d: "Jump to each state's official license and regulations page from the map." },
];
const steps = A
  ? [
      { t: "Open Google Play", d: "Tap the Get it on Google Play button on this page, or search for \"PB Fishing: Catch & Compete\" in the Play Store." },
      { t: "Install", d: "Tap Install. The app is free to download." },
      { t: "Create your account", d: "Sign up, pick your state and the species you fish for." },
      { t: "Log your first catch", d: "Tap the camera button, take a side-profile photo and save. Your first fish is your first PB." },
    ]
  : [
      { t: "Open the App Store", d: "Tap the Download on the App Store button on this page, or search for \"PB Fishing: Catch & Compete\" in the App Store." },
      { t: "Get", d: "Tap Get. The app is free to download and runs on iOS 17.6 or later." },
      { t: "Create your account", d: "Sign up, pick your state and the species you fish for." },
      { t: "Log your first catch", d: "Tap the camera button, take a side-profile photo and save. Your first fish is your first PB." },
    ];
const cancel = A
  ? "Subscriptions on Android are billed by Google Play. To cancel, open the Play Store, tap your profile picture, then **Payments & subscriptions → Subscriptions → PB Fishing → Cancel subscription**. Premium stays active until the end of the period you paid for."
  : "Subscriptions on iPhone are billed by Apple. To cancel, open **Settings → your name → Subscriptions → PB Fishing** and tap Cancel Subscription. Premium stays active until the end of the period you paid for.";
const faq = [
  { q: `Is PB Fishing available on ${name}?`, a: A ? "Yes. PB Fishing: Catch & Compete is on Google Play for Android phones, published by UZSPOWER LLC. It's also on the App Store for iPhone." : "Yes. PB Fishing: Catch & Compete is on the App Store for iPhone (iOS 17.6 or later), published by UZSPOWER LLC. It's also on Google Play for Android." },
  { q: "Is PB Fishing free?", a: "Yes. Downloading and unlimited catch logging are free forever, along with 5 photo identifications, a top-10 leaderboard preview, the daily bite forecast and up to 2 planned trips. Premium ($3.99 a month or $29.99 a year in the US, with a 7-day free trial on the yearly plan) adds the full national leaderboard, hourly bite forecast and species odds, catch insights and unlimited trips." },
  { q: "Does PB Fishing work without cell service?", a: "You can log catches with no signal: they're saved on your phone and upload when you're back online. Maps, forecasts and leaderboards need a connection." },
  { q: "Will other anglers see my fishing spot?", a: "Not from the leaderboard: an entry shows your name, state, length and weight, not the lake or coordinates. Posts you share to the community feed are separate, so check your photo and caption before posting." },
  { q: `How do I cancel Premium on ${name}?`, a: cancel },
  { q: "What's the best fishing app?", a: "It depends on the job: we compare the options honestly, including where other apps are better, in [best fishing apps](/blog/best-fishing-apps)" + (A ? " and [best fishing apps for Android](/blog/best-fishing-apps-android)." : " and [best fishing apps for iPhone](/blog/best-fishing-apps-iphone).") },
];
const title = A ? "PB Fishing for Android: Free Fishing Log, PBs & Leaderboards" : "PB Fishing for iPhone: Free Fishing Log, PBs & Leaderboards";
const description = A
  ? "PB Fishing on Google Play: a free, photo-backed fishing log for Android with automatic personal bests, state leaderboards, bite forecasts and 20,000+ US waters."
  : "PB Fishing on the App Store: a free, photo-backed fishing log for iPhone with automatic personal bests, state leaderboards, bite forecasts and 20,000+ US waters.";
const ld = [
  {
    "@type": "MobileApplication", "@id": `${SITE}${path}#app`, name: "PB Fishing: Catch & Compete", operatingSystem: A ? "Android" : "iOS 17.6 or later",
    applicationCategory: "LifestyleApplication", url: A ? PLAY_STORE : APP_STORE, installUrl: A ? PLAY_STORE : APP_STORE, publisher: { "@id": `${SITE}/#org` },
    image: `${SITE}/brand/pb-logo-512.png`, description,
    offers: [
      { "@type": "Offer", name: "Free", price: "0", priceCurrency: "USD" },
      { "@type": "Offer", name: "Premium yearly", price: "29.99", priceCurrency: "USD" },
      { "@type": "Offer", name: "Premium monthly", price: "3.99", priceCurrency: "USD" },
    ],
  },
  { "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: plain(f.a) } })) },
  { "@type": "HowTo", name: `How to install PB Fishing on ${name}`, step: steps.map((s, i) => ({ "@type": "HowToStep", position: i + 1, name: s.t, text: s.d })) },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: `${SITE}/` }, { "@type": "ListItem", position: 2, name: `PB Fishing for ${name}`, item: `${SITE}${path}` }] },
];
---
<Base title={title} description={description} path={path} ogImage={`/og/pages/${platform}.jpg`} ogImageAlt={`PB Fishing for ${name}`} jsonLd={ld} campaign="platform" content={platform}>
  <style>
    .pl-hero { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.5rem; align-items: center; padding-block: clamp(2rem, 5vw, 3.5rem); }
    .pl-hero h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); }
    .pl-hero figure { margin: 0; border-radius: var(--r-hero); overflow: hidden; box-shadow: var(--shadow-2); }
    .pl-hero figure img { aspect-ratio: 16 / 10; object-fit: cover; width: 100%; }
    .pl-cta { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; align-items: center; margin-top: 1.5rem; }
    .pl-feats { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 1rem; }
    .pl-feats li { list-style: none; padding: 1.25rem; }
    .pl-feats .icon { color: var(--gold-text, #8a6508); width: 26px; height: 26px; margin-bottom: 0.6rem; }
    .pl-feats h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
    .pl-feats p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
    .pl-shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .pl-shots img { border-radius: 22px; box-shadow: var(--shadow-2); border: 1px solid var(--line); }
    .pl-steps { counter-reset: s; list-style: none; padding: 0; display: grid; gap: 0.9rem; }
    .pl-steps li { display: grid; grid-template-columns: 2.4rem 1fr; gap: 0.9rem; align-items: start; }
    .pl-steps li::before { counter-increment: s; content: counter(s); width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--navy); color: var(--bone); display: grid; place-items: center; font-weight: 800; }
    .pl-steps b { display: block; color: var(--navy); }
    @media (max-width: 820px) { .pl-hero { grid-template-columns: 1fr; } .pl-shots { grid-template-columns: 1fr 1fr; } .pl-shots > :last-child { display: none; } }
  </style>
  <section class="wrap pl-hero">
    <div>
      <ol class="crumbs"><li><a href="/">Home</a></li></ol>
      <span class="kicker">{A ? "Now on Google Play" : "On the App Store"}</span>
      <h1>PB Fishing for {name}</h1>
      <p class="lead">The fishing log that keeps an honest record: photo-backed catches, personal bests by species, and state and national leaderboards. Free to download on {store}; catch logging is free forever.</p>
      <div class="pl-cta">
        <a class="btn btn-gold" href={link("hero")} data-cta="hero" data-store={A ? "google" : "apple"}><Icon name="download" /> Get it on {A ? "Google Play" : "the App Store"}</a>
        <a href={other.href}>{other.label} →</a>
      </div>
    </div>
    <figure><Picture src={hero} formats={["avif", "webp"]} widths={[480, 800, 1200]} sizes="(max-width: 820px) 100vw, 520px" alt={`PB Fishing for ${name}`} loading="eager" fetchpriority="high" /></figure>
  </section>

  <section class="wrap section" style="padding-top:1rem">
    <div class="section-head"><h2>What you get</h2><p>Built for anglers who want progress, not guesswork.</p></div>
    <ul class="pl-feats" style="padding:0;margin:0">
      {features.map((f) => <li class="card"><Icon name={f.icon} size={26} /><h3>{f.t}</h3><p>{f.d}</p></li>)}
    </ul>
  </section>

  <section class="wrap">
    <div class="pl-shots">
      <Picture src={shotCatch} formats={["avif", "webp"]} widths={[300, 450]} sizes="(max-width: 820px) 45vw, 360px" alt="Log a catch with photo, species, length and weight" loading="lazy" />
      <Picture src={shotBoard} formats={["avif", "webp"]} widths={[300, 450]} sizes="(max-width: 820px) 45vw, 360px" alt="Largemouth bass leaderboard with rankings by state" loading="lazy" />
      <Picture src={shotCond} formats={["avif", "webp"]} widths={[300, 450]} sizes="360px" alt="Bite forecast with hourly scores and conditions" loading="lazy" />
    </div>
    {A && <p class="muted" style="font-size:.85rem;margin-top:.6rem">Screens shown from the iPhone app; the Android app has the same features.</p>}
  </section>

  <section class="wrap section"><div class="prose" style="max-width:var(--prose)">
    <h2>Free vs Premium</h2>
    <div class="table-scroll"><table>
      <thead><tr><th></th><th>Free</th><th>Premium</th></tr></thead>
      <tbody>
        <tr><td>Catch logging</td><td>Unlimited</td><td>Unlimited</td></tr>
        <tr><td>Photo identifications</td><td>5</td><td>Unlimited</td></tr>
        <tr><td>Leaderboards</td><td>Top 10 preview</td><td>Full national and state</td></tr>
        <tr><td>Bite forecast</td><td>Daily</td><td>Hourly + species odds</td></tr>
        <tr><td>Trip planner</td><td>Up to 2 trips</td><td>Unlimited</td></tr>
        <tr><td>Insights and history</td><td>Basic</td><td>Catch trends, PB progress, 10-day weather and catch history</td></tr>
        <tr><td>Price (US)</td><td>$0</td><td>$3.99/month or $29.99/year, 7-day free trial on yearly</td></tr>
      </tbody>
    </table></div>
    <p set:html={inline(cancel)} />

    <h2>Install in a minute</h2>
    <ol class="pl-steps">{steps.map((s) => <li><span><b>{s.t}</b>{s.d}</span></li>)}</ol>

    <section class="faq" aria-labelledby="faq-h">
      <h2 id="faq-h">Questions anglers ask</h2>
      {faq.map((f) => <details><summary>{f.q}</summary><p set:html={inline(f.a)} /></details>)}
    </section>
  </div></section>

  <section class="wrap section" style="padding-top:0">
    <div class="row-between"><h2>How PB Fishing compares</h2><a href="/blog/category/apps">All app guides →</a></div>
    <div class="grid grid-3">{appPosts.map((p) => <PostCard href={`/blog/${p.id}`} title={p.data.title} text={p.data.description} meta={CATEGORY_LABEL[p.data.category]} image={heroFor("blog", p.id)} alt={p.data.heroAlt} />)}</div>
  </section>

  <section class="wrap">
    <div class="app-cta">
      <img class="app-icon" src="/brand/pb-logo-192.png" alt="" width="64" height="64" loading="lazy" />
      <div>
        <p class="h3" role="heading" aria-level="2">Your next PB deserves a record</p>
        <p>Free on {store}. Log the catch, keep the PB, see where it ranks in your state.</p>
        <div class="cta-row"><a class="btn btn-gold" href={link("end")} data-cta="end" data-store={A ? "google" : "apple"}>Get PB Fishing for {name}</a></div>
      </div>
    </div>
  </section>
</Base>
