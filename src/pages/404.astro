  <section class="page-hero wrap" style="min-height:50vh">
    <span class="kicker">404</span>
    <h1>Skunked. This page isn't here.</h1>
    <p class="lead">The link may be old or mistyped. Try one of these instead:</p>
    <div class="hub-links"><a class="chip" href="/">Home</a><a class="chip" href="/blog">Blog</a><a class="chip" href="/fishing">Fishing by state</a><a class="chip" href="/species">Species</a><a class="chip" href="/quiz">Quizzes</a><a class="chip" href="/support">Support</a></div>
  </section>
</Base>
