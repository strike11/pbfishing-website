---
import Base from "@/layouts/Base.astro";
import PostCard from "@/components/PostCard.astro";
import AppCta from "@/components/AppCta.astro";
import { allPosts, heroFor, CATEGORY_LABEL } from "@/lib/content";
import { STATES } from "@/data/states";
import { QUIZZES } from "@/data/quizzes";

const posts = await allPosts();
const cats = Object.entries(CATEGORY_LABEL).filter(([k]) => posts.some((p) => p.data.category === k));
const [lead, ...rest] = posts;
const ld = [{
  "@type": "Blog", "@id": "https://pbfishing.app/blog#blog", name: "PB Fishing blog", url: "https://pbfishing.app/blog",
  description: "Fishing guides, app comparisons, species and state guides from the PB Fishing team.",
  publisher: { "@id": "https://pbfishing.app/#org" },
  blogPost: posts.slice(0, 20).map((p) => ({ "@type": "BlogPosting", headline: p.data.title, url: `https://pbfishing.app/blog/${p.id}`, datePublished: p.data.published.toISOString().slice(0, 10) })),
}, { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://pbfishing.app/" }, { "@type": "ListItem", position: 2, name: "Blog", item: "https://pbfishing.app/blog" }] }];
---
<Base title="Fishing Blog: Guides, Tips & App Comparisons" description="Practical fishing guides from the PB Fishing team: how to measure and log a fish, bass tactics by season, weather and bite windows, and honest fishing app comparisons." path="/blog" jsonLd={ld} campaign="blog" content="index">
  <section class="page-hero wrap">
    <span class="kicker">The PB Fishing blog</span>
    <h1>Fish smarter. Keep an honest record.</h1>
    <p class="lead">Guides built from what anglers actually ask on the water: where to go, what is biting, how to measure the fish, and which app is worth your phone's storage.</p>
    <nav class="hub-links" aria-label="Categories">
      {cats.map(([k, v]) => <a class="chip" href={`/blog/category/${k}`}>{v}</a>)}
      <a class="chip" href="/fishing">Fishing by state</a>
      <a class="chip" href="/species">Species guides</a>
      <a class="chip" href="/quiz">Quizzes</a>
    </nav>
  </section>
  <section class="wrap">
    {lead && <div class="grid" style="grid-template-columns:1fr;margin-bottom:1.25rem"><PostCard href={`/blog/${lead.id}`} title={lead.data.title} text={lead.data.description} meta={CATEGORY_LABEL[lead.data.category]} image={heroFor("blog", lead.id)} alt={lead.data.heroAlt} eager /></div>}
    <div class="grid grid-3">
      {rest.map((p, i) => <PostCard href={`/blog/${p.id}`} title={p.data.title} text={p.data.description} meta={CATEGORY_LABEL[p.data.category]} image={heroFor("blog", p.id)} alt={p.data.heroAlt} eager={i < 3} />)}
    </div>
  </section>
  <section class="wrap section">
    <div class="section-head"><h2>Fishing guides by state</h2><p>Lakes, seasons, license rules and state records, checked against each state's wildlife agency.</p></div>
    <div class="state-grid">{STATES.filter((s) => s.live).map((s) => <a class="state-link" href={`/fishing/${s.slug}`}>{s.name}<small>{s.abbr}</small></a>)}</div>
    <div class="section-head" style="margin-top:3rem"><h2>Quick quizzes</h2></div>
    <div class="hub-links">{QUIZZES.map((q) => <a class="chip" href={`/quiz/${q.slug}`}>{q.title}</a>)}</div>
    <AppCta campaign="blog" content="index" />
  </section>
</Base>
