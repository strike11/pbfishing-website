---
import Base from "@/layouts/Base.astro";
import QuizIcon from "@/components/QuizIcon.astro";
import AppCta from "@/components/AppCta.astro";
import { QUIZZES } from "@/data/quizzes";
const ld = [
  { "@type": "CollectionPage", "@id": "https://pbfishing.app/quiz", name: "Fishing quizzes", url: "https://pbfishing.app/quiz",
    mainEntity: { "@type": "ItemList", itemListElement: QUIZZES.map((q, i) => ({ "@type": "ListItem", position: i + 1, name: q.title, url: `https://pbfishing.app/quiz/${q.slug}` })) } },
  { "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Home", item: "https://pbfishing.app/" }, { "@type": "ListItem", position: 2, name: "Quizzes", item: "https://pbfishing.app/quiz" }] },
];
---
<Base title="Fishing Quizzes: Angler Type, Lure Picker & Fishing IQ" description="Free one-minute fishing quizzes: find your angler type, pick the right bass lure for today's conditions, and test your fishing IQ. Share your result." path="/quiz" jsonLd={ld} campaign="quiz" content="index">
  <section class="page-hero wrap">
    <ol class="crumbs"><li><a href="/">Home</a></li></ol>
    <h1>Fishing quizzes</h1>
    <p class="lead">One minute each, no sign-up. Built the same way as the questions in the PB Fishing app, with a result you can actually use on the water.</p>
  </section>
  <section class="wrap">
    <div class="grid grid-3">
      {QUIZZES.map((q) => (
        <a class="card post-card" href={`/quiz/${q.slug}`} style="padding:1.35rem">
          <QuizIcon name={q.icon} tint={q.tint} size="lg" />
          <h3 style="margin-top:1rem">{q.title}</h3>
          <p>{q.description}</p>
          <span class="pc-meta" style="margin-top:.5rem">{q.questions.length} questions · {q.kind === "trivia" ? "Test yourself" : "Find your type"}</span>
        </a>
      ))}
    </div>
    <AppCta campaign="quiz" content="index" />
  </section>
</Base>
