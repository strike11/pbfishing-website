---
import Base from "@/layouts/Base.astro";
import Icon from "@/components/Icon.astro";
const faq = [
  { q: "How do I manage or cancel my subscription?", a: "Subscriptions are handled by Apple. On your device, open <strong>Settings → [your name] → Subscriptions</strong>, select PB FISHING, and choose to change or cancel your plan. Cancellations take effect at the end of the current billing period." },
  { q: "How do I delete my account?", a: "You can permanently delete your account from within the app: <strong>Profile → Settings → Delete Account</strong>. This removes your account and associated data and is irreversible." },
  { q: "I found a bug. What should I do?", a: "Please email us at <a href=\"mailto:support@pbfishing.app\">support@pbfishing.app</a> with a description, your device and app version, and a screenshot if possible. Bug reports help us improve the app for everyone." },
  { q: "How is my data handled?", a: "We never sell your personal information. Read the full <a href=\"/privacy-policy\">Privacy Policy</a> for details on what we collect and how it's protected." },
];
const strip = (s: string) => s.replace(/<[^>]+>/g, "");
const ld = [
  { "@type": "ContactPage", "@id": "https://pbfishing.app/support", url: "https://pbfishing.app/support", name: "PB Fishing support", about: { "@id": "https://pbfishing.app/#app" } },
  { "@type": "FAQPage", mainEntity: faq.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: strip(f.a) } })) },
];
---
<Base title="Support" description="Get help with PB FISHING, the iOS fishing companion by UZSPOWER LLC. Contact our support team at support@pbfishing.app, manage subscriptions, delete your account." path="/support" jsonLd={ld} campaign="support" content="support" sticky={false}>
  <section class="page-hero wrap" style="max-width:780px">
    <span class="kicker">Support</span>
    <h1>We're here to help</h1>
    <p class="lead">Questions, bug reports, account help, or feedback: our team is ready to reel in a solution.</p>
  </section>
  <div class="wrap" style="max-width:780px">
    <section class="app-cta" style="grid-template-columns:auto 1fr">
      <span class="app-icon" style="display:grid;place-items:center;width:64px;height:64px;border-radius:16px;background:rgba(212,160,23,.16);color:var(--gold-bright)"><Icon name="mail" size={30} /></span>
      <div>
        <h2 class="h3" style="color:var(--bone);font-size:1.25rem">Email our support team</h2>
        <p>Send us a message and we'll get back to you, usually within 1–2 business days. Please include your account email and a description of the issue.</p>
        <div class="cta-row"><a class="btn btn-gold" href="mailto:support@pbfishing.app?subject=PB%20FISHING%20Support%20Request">Contact support</a><span class="cta-note">or write directly to <a href="mailto:support@pbfishing.app" style="color:var(--gold-bright)">support@pbfishing.app</a></span></div>
      </div>
    </section>
    <section class="prose" style="max-width:none">
      <h2>What to include in your message</h2>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(min(100%,320px),1fr))">
        <div class="card" style="padding:1.1rem 1.2rem"><strong>Your account email</strong><p style="margin:.3rem 0 0;font-size:.95rem">The email address you use to sign in to PB FISHING so we can locate your account.</p></div>
        <div class="card" style="padding:1.1rem 1.2rem"><strong>What happened</strong><p style="margin:.3rem 0 0;font-size:.95rem">A clear description of the issue or question, and the steps that led to it.</p></div>
        <div class="card" style="padding:1.1rem 1.2rem"><strong>Device &amp; app version</strong><p style="margin:.3rem 0 0;font-size:.95rem">Your iPhone/iPad model, iOS version, and the PB FISHING version (Settings → About).</p></div>
        <div class="card" style="padding:1.1rem 1.2rem"><strong>Screenshots</strong><p style="margin:.3rem 0 0;font-size:.95rem">If something looks wrong, a screenshot or screen recording helps us diagnose it quickly.</p></div>
      </div>
      <section class="faq" aria-labelledby="faq-h">
        <h2 id="faq-h">Frequently asked</h2>
        {faq.map((f) => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}
      </section>
      <h2>About PB FISHING</h2>
      <p>PB FISHING is owned and operated by <strong>UZSPOWER LLC</strong>, United States. For legal inquiries, see our <a href="/eula">EULA</a> and <a href="/privacy-policy">Privacy Policy</a>.</p>
    </section>
  </div>
</Base>
